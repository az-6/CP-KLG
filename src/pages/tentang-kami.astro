---
import ButtonLink from '../components/ButtonLink.astro';
import CompanyFacts from '../components/CompanyFacts.astro';
import CredentialGallery from '../components/CredentialGallery.astro';
import MediaGallery from '../components/MediaGallery.astro';
import OceanPanel from '../components/OceanPanel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { company } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasItems } from '../lib/optional-sections';
import { getAboutEvidence } from '../lib/sanity/evidence-repository';
import { getMeetingHref } from '../lib/whatsapp';

const meetingHref = getMeetingHref(company.contact.whatsappNumber);
const evidence = await getAboutEvidence();
---

<BaseLayout
  title="Tentang PT Katalis Lintas Global"
  description="Kenali PT Katalis Lintas Global, pemasok tuna dan ikan dasar untuk distributor serta pedagang besar di Indonesia."
  canonicalPath="/tentang-kami"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Profil perusahaan</span>
      <h1>Tentang PT Katalis Lintas Global</h1>
      <p>Kami membangun kemitraan pasokan melalui mutu yang konsisten, penanganan higienis, dan komunikasi yang memahami kebutuhan buyer.</p>
    </div>
  </section>

  <section class="section">
    <div class="container story-grid">
      <OceanPanel compact />
      <div>
        <SectionHeading eyebrow="Siapa kami" title="Mitra Pasokan untuk Pertumbuhan Bisnis" />
        <p class="lead">{company.about}</p>
        <p>Pendekatan kami dimulai dari memahami kebutuhan buyer sebelum masuk ke pembahasan spesifikasi, kapasitas, dan pola distribusi. Dengan begitu, komunikasi bisnis berfokus pada kecocokan kebutuhan dan kemampuan pasokan.</p>
      </div>
    </div>
  </section>

  {hasItems(evidence.facts) && (
    <section class="section">
      <div class="container"><CompanyFacts facts={evidence.facts} label="Fakta perusahaan" /></div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container">
      <SectionHeading eyebrow="Nilai kerja" title="Prinsip yang Menjaga Kemitraan" align="center" />
      <div class="values">
        <article><span>01</span><h2>Konsistensi</h2><p>Menjaga perhatian terhadap standar mutu pada setiap tahapan operasional.</p></article>
        <article><span>02</span><h2>Keterbukaan</h2><p>Membahas kemampuan, spesifikasi, dan kebutuhan secara jelas sejak awal.</p></article>
        <article><span>03</span><h2>Fleksibilitas</h2><p>Mencari bentuk pemenuhan yang sesuai dengan kebutuhan buyer.</p></article>
      </div>
    </div>
  </section>

  {hasItems(evidence.team) && (
    <section class="section">
      <div class="container">
        <SectionHeading eyebrow="Orang di balik operasional" title="Tim Kami" />
        <MediaGallery items={evidence.team} label="Dokumentasi tim" />
      </div>
    </section>
  )}

  {hasItems(evidence.fleet) && (
    <section class="section section--soft">
      <div class="container">
        <SectionHeading eyebrow="Dukungan distribusi" title="Armada" />
        <MediaGallery items={evidence.fleet} label="Dokumentasi armada" />
      </div>
    </section>
  )}

  {hasItems(evidence.activities) && (
    <section class="section">
      <div class="container">
        <SectionHeading eyebrow="Kegiatan perusahaan" title="Aktivitas" />
        <MediaGallery items={evidence.activities} label="Dokumentasi aktivitas" />
      </div>
    </section>
  )}

  {hasItems(evidence.credentials) && (
    <section class="section section--soft">
      <div class="container">
        <SectionHeading eyebrow="Kredibilitas" title="Legalitas dan Sertifikasi" description="Pratinjau dokumen publik yang telah disetujui untuk ditampilkan." />
        <CredentialGallery credentials={evidence.credentials} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container cta-panel">
      <div><h2>Bangun Kemitraan Bersama Kami</h2><p>Mulai dengan pertemuan singkat untuk mengenal kebutuhan bisnis dan kemampuan pasokan yang relevan.</p></div>
      <ButtonLink href={meetingHref} label="Jadwalkan Pertemuan" analyticsSource="about-final" external={meetingHref.startsWith('https://wa.me/')} />
    </div>
  </section>
</BaseLayout>

<style>
  .story-grid { display: grid; grid-template-columns: 0.85fr 1fr; align-items: center; gap: clamp(2.5rem, 7vw, 6rem); }
  .story-grid :global(.section-heading) { margin-bottom: 1.5rem; }
  .story-grid p { color: var(--slate); }
  .values { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .values article { padding: 2rem; border-right: 1px solid var(--line); }
  .values article:last-child { border-right: 0; }
  .values span { color: var(--ocean-600); font-size: 0.75rem; font-weight: 600; }
  .values h2 { margin-block: 2rem 1rem; font-size: 1.7rem; }
  .values p { margin-bottom: 0; color: var(--slate); font-size: 0.95rem; }
  @media(max-width:780px) { .story-grid, .values { grid-template-columns: 1fr; } .values article { border-right: 0; border-bottom: 1px solid var(--line); padding-inline: 0; } .values article:last-child { border-bottom: 0; } }
</style>
