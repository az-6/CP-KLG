---
import ButtonLink from '../components/ButtonLink.astro';
import CompanyFacts from '../components/CompanyFacts.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';
import OceanPanel from '../components/OceanPanel.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import ProofCard from '../components/ProofCard.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { company } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasItems } from '../lib/optional-sections';
import { getHomeFacts } from '../lib/sanity/evidence-repository';
import { getActivePartners, getLatestNews } from '../lib/sanity/news-partner-repository';
import { getProductCatalog } from '../lib/sanity/product-repository';
import { getMeetingHref } from '../lib/whatsapp';
const meetingHref = getMeetingHref(company.contact.whatsappNumber);
const [{ products }, latestNews, partners, homeFacts] = await Promise.all([
  getProductCatalog(), getLatestNews(3), getActivePartners(), getHomeFacts(),
]);
const featuredProducts = products.slice(0, 4);
---
<BaseLayout title="Pemasok Ikan B2B Indonesia" description="PT Katalis Lintas Global memasok tuna dan ikan dasar untuk distributor serta pedagang besar dengan kualitas konsisten, higienis, dan spesifikasi fleksibel." canonicalPath="/">
  <Hero eyebrow="Mitra pasokan ikan untuk bisnis Indonesia" title="Pasokan ikan." description={company.heroDescription} primaryHref={meetingHref} />

  <section id="kenali-klg" class="section introduction">
    <div class="container">
      <div class="introduction__grid">
        <div><span class="eyebrow">01 / Mengenal KLG</span><h2>Mitra pasokan Anda.<br />Dari awal, hingga tumbuh bersama.</h2></div>
        <div class="introduction__copy"><p class="lead">{company.about}</p><ButtonLink href="/tentang-kami" label="Kenali Perusahaan Kami" variant="text" /></div>
      </div>
      {hasItems(homeFacts) && <div class="introduction__facts"><CompanyFacts facts={homeFacts} label="Ringkasan perusahaan" /></div>}
    </div>
  </section>

  <section class="section section--soft catalog-preview">
    <div class="container">
      <div class="section-topline">
        <SectionHeading eyebrow="02 / Pilihan produk" title="Produk untuk Kebutuhan Bisnis Anda" description="Tuna dan ikan dasar, dengan spesifikasi yang mengikuti kebutuhan pasokan Anda." />
        <ButtonLink href="/produk" label="Semua Produk" variant="text" />
      </div>
      {hasItems(featuredProducts) ? <div class="category-grid">{featuredProducts.map((product) => <ProductCard product={product} headingLevel="h3" />)}</div> : <p class="empty-note">Diskusikan pilihan tuna dan ikan dasar yang sesuai dengan kebutuhan bisnis Anda melalui kontak resmi kami.</p>}
    </div>
  </section>

  <section class="section">
    <div class="container quality-preview">
      <OceanPanel />
      <div class="quality-preview__copy">
        <SectionHeading eyebrow="03 / Komitmen kami" title="Kepercayaan Dibangun dari Bukti" description="Perhatian pada mutu, keterbukaan spesifikasi, dan penanganan yang higienis menjadi dasar setiap kemitraan." />
        <div class="quality-preview__proofs">{company.proofs.map((proof) => <ProofCard {...proof} compact />)}</div>
        <ButtonLink href="/mutu-proses" label="Pelajari Mutu & Proses" variant="text" />
      </div>
    </div>
  </section>

  <section class="section section--soft process-section">
    <div class="container">
      <SectionHeading eyebrow="04 / Rantai penanganan" title="Mutu dari Penerimaan hingga Pengiriman" description="Setiap tahapan saling terhubung untuk menjaga kualitas produk sampai ke kebutuhan bisnis Anda." />
      <ProcessTimeline steps={company.process} compact />
    </div>
  </section>

  <section class="section section--dark specification">
    <div class="container specification__grid">
      <div class="specification__copy">
        <span class="eyebrow">Dirancang untuk kebutuhan B2B</span>
        <h2>Spesifikasi Mengikuti Kebutuhan Buyer</h2>
        <p>Jenis produk, volume, hingga pola distribusi. Kami memulai setiap kemitraan dengan memahami kebutuhan bisnis Anda.</p>
        <ButtonLink href={meetingHref} label="Diskusikan Kebutuhan Anda" analyticsSource="specification" external={meetingHref.startsWith('https://wa.me/')} />
      </div>
      <div class="specification__details">
        <span class="specification__caption">SETIAP KEBUTUHAN, DIBAHAS BERSAMA</span>
        <ul class="specification__list">
          {['Ukuran & grade', 'Bentuk produk', 'Kondisi produk', 'Pengemasan', 'Volume & distribusi'].map((label, index) => <li><span>0{index + 1}</span><strong>{label}</strong><i aria-hidden="true">↗</i></li>)}
        </ul>
      </div>
    </div>
  </section>

  {hasItems(partners) && (
    <section class="section partners-section" aria-labelledby="partners-title">
      <div class="container partners-layout">
        <div><span class="eyebrow">Bertumbuh bersama</span><h2 id="partners-title">Mitra Kerja</h2><p>Hubungan baik untuk kemitraan jangka panjang.</p></div>
        <PartnerGrid {partners} />
      </div>
    </section>
  )}

  {hasItems(latestNews) && (
    <section class="section section--soft" aria-labelledby="latest-news-title" data-latest-news>
      <div class="container">
        <div class="section-topline"><div><span class="eyebrow">Dari Katalis Lintas Global</span><h2 id="latest-news-title">Cerita & Kabar Terbaru</h2></div><ButtonLink href="/berita" label="Semua Berita" variant="text" /></div>
        <div class:list={['latest-news-grid', { 'latest-news-grid--single': latestNews.length === 1, 'latest-news-grid--two': latestNews.length === 2 }]}>{latestNews.map((article) => <NewsCard {article} headingLevel="h3" />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container cta-panel">
      <div><span class="eyebrow">Mari mulai percakapan</span><h2>Kebutuhan Anda.<br />Langkah kita berikutnya.</h2><p>Diskusikan produk, spesifikasi, dan kebutuhan pasokan bisnis Anda bersama tim kami.</p></div>
      <ButtonLink href={meetingHref} label="Jadwalkan Pertemuan" analyticsSource="home-final" external={meetingHref.startsWith('https://wa.me/')} />
    </div>
  </section>
</BaseLayout>
<style>
  .introduction__grid { display: grid; grid-template-columns: 1fr 0.85fr; gap: clamp(2rem, 8vw, 8rem); align-items: center; }
  .introduction h2 { max-width: 23ch; margin-bottom: 0; }
  .introduction__copy p { margin-bottom: 1rem; font-size: 1.03rem; }
  .introduction__facts { margin-top: 3rem; }
  .section-topline { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .section-topline :global(.section-heading) { max-width: 42rem; margin-bottom: 0; }
  .section-topline :global(.section-heading p) { margin-bottom: 0; }
  .section-topline > :global(.button-link) { flex-shrink: 0; }
  .section-topline h2 { margin-bottom: 0; }
  .category-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; }
  .quality-preview { display: grid; grid-template-columns: 0.9fr 1fr; align-items: stretch; gap: clamp(2.5rem, 6.5vw, 6rem); }
  .quality-preview__copy :global(.section-heading) { margin-bottom: 0.5rem; }
  .quality-preview__copy > :global(.button-link) { margin-top: 1rem; }
  .process-section :global(.section-heading) { max-width: 43rem; }
  .specification__grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .specification h2 { max-width: 17ch; }
  .specification p { max-width: 31rem; margin-bottom: 2rem; font-size: 1rem; }
  .specification :global(.button-link--primary) { color: var(--navy-950); background: var(--mint); }
  .specification :global(.button-link--primary:hover) { background: #d6ebe2; }
  .specification :global(:focus-visible) { outline-color: var(--mint); }
  .specification__caption { display: block; margin-bottom: 1rem; color: #b7cfcf; font-size: 0.66rem; letter-spacing: 0.14em; }
  .specification__list { margin: 0; padding: 0; list-style: none; }
  .specification__list li { display: grid; grid-template-columns: 2.5rem 1fr 1.5rem; align-items: center; gap: 1rem; padding-block: 1.1rem; border-top: 1px solid #416169; }
  .specification__list li:last-child { border-bottom: 1px solid #416169; }
  .specification__list span { color: var(--mint); font-size: 0.75rem; }
  .specification__list strong { color: var(--white); font-weight: 500; font-size: 1.13rem; }
  .specification__list i { color: var(--mint); font-style: normal; }
  .partners-layout { display: grid; grid-template-columns: 0.6fr 1fr; align-items: center; gap: 3rem; }
  .partners-layout h2 { margin-bottom: 1rem; }
  .partners-layout p { max-width: 21rem; color: var(--slate); margin-bottom: 0; }
  .latest-news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem; }
  .latest-news-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .latest-news-grid--single { grid-template-columns: 1fr; }
  .latest-news-grid--single :global(.news-card) { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; border: 0; }
  .latest-news-grid--single :global(.news-card h3) { font-size: 2rem; }
  .latest-news-grid--single :global(.news-card__body) { padding-right: 2rem; }
  @media (max-width: 780px) {
    .introduction__grid, .quality-preview, .specification__grid, .partners-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .section-topline { display: grid; gap: 1rem; }
    .section-topline > :global(.button-link) { justify-self: start; }
    .quality-preview > :global(.ocean-panel) { order: 2; }
    .category-grid, .latest-news-grid { grid-template-columns: 1fr; }
    .latest-news-grid--single :global(.news-card) { grid-template-columns: 1fr; gap: 0; }
    .latest-news-grid--single :global(.news-card__body) { padding-right: 0; }
    .specification h2 { max-width: 20ch; }
  }
</style>
