---
import ButtonLink from '../components/ButtonLink.astro';
import Hero from '../components/Hero.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import ProofCard from '../components/ProofCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { company } from '../data/company';
import { products } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMeetingHref } from '../lib/whatsapp';

const meetingHref = getMeetingHref(company.contact.whatsappNumber);
const trustFacts = [
  { value: 'B2B', label: 'Fokus distributor & pedagang besar' },
  { value: 'Tonase', label: 'Orientasi pasokan skala besar' },
  { value: 'Custom', label: 'Spesifikasi mengikuti kebutuhan buyer' },
];
---

<BaseLayout
  title="Pemasok Ikan B2B Indonesia"
  description="PT Katalis Lintas Global memasok tuna dan ikan dasar untuk distributor serta pedagang besar dengan kualitas konsisten, higienis, dan spesifikasi fleksibel."
  canonicalPath="/"
>
  <Hero
    eyebrow="Pemasok ikan untuk bisnis Indonesia"
    title={company.heroTitle}
    description={company.heroDescription}
    primaryHref={meetingHref}
  />

  <section class="trust-strip" aria-label="Ringkasan kemampuan perusahaan">
    <div class="container trust-strip__grid">
      {trustFacts.map((fact) => (
        <div class="trust-strip__item">
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Produk utama"
        title="Produk untuk Kebutuhan Bisnis Anda"
        description="Katalog kami berfokus pada kategori yang tersedia secara relatif stabil sepanjang tahun. Detail ukuran, bentuk, dan pengemasan dibahas sesuai kebutuhan operasional buyer."
      />
      <div class="category-grid">
        {products.map((product, index) => (
          <a class="category-card" href={`/produk#${product.slug}`}>
            <span class="category-card__index">0{index + 1}</span>
            <div>
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <span class="category-card__link">Lihat kategori <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHeading
        eyebrow="Alasan memilih kami"
        title="Kepercayaan Dibangun dari Bukti"
        description="Setiap janji utama dikaitkan dengan proses operasional yang dapat dijelaskan dalam pertemuan bisnis."
      />
      <div class="grid grid--3">
        {company.proofs.map((proof) => <ProofCard {...proof} />)}
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <SectionHeading
        eyebrow="Rantai penanganan"
        title="Mutu dari Penerimaan hingga Pengiriman"
        description="Pendekatan terstruktur membantu menjaga konsistensi produk ketika bergerak dari penerimaan menuju distribusi."
      />
      <ProcessTimeline steps={company.process} compact />
      <div class="section-link">
        <ButtonLink href="/mutu-proses" label="Pelajari Mutu & Proses" variant="text" />
      </div>
    </div>
  </section>

  <section class="section section--dark specification">
    <div class="container specification__grid">
      <div>
        <span class="eyebrow">Fleksibilitas B2B</span>
        <h2>Spesifikasi Mengikuti Kebutuhan Buyer</h2>
        <p>Setiap distributor memiliki kebutuhan yang berbeda. Pertemuan awal digunakan untuk menyelaraskan spesifikasi produk, volume, pengemasan, dan pola distribusi sebelum pembahasan berlanjut.</p>
        <ButtonLink href={meetingHref} label="Diskusikan Kebutuhan Anda" analyticsSource="specification" external={meetingHref.startsWith('https://wa.me/')} />
      </div>
      <ul class="specification__list">
        <li><span>01</span><strong>Ukuran & grade</strong></li>
        <li><span>02</span><strong>Bentuk produk</strong></li>
        <li><span>03</span><strong>Kondisi produk</strong></li>
        <li><span>04</span><strong>Pengemasan</strong></li>
        <li><span>05</span><strong>Volume & distribusi</strong></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container about-preview">
      <div class="about-preview__visual" aria-hidden="true">
        <span>KLG</span>
        <div></div>
      </div>
      <div>
        <span class="eyebrow">Tentang perusahaan</span>
        <h2>Kemitraan Pasokan yang Berorientasi Jangka Panjang</h2>
        <p class="lead">{company.about}</p>
        <ButtonLink href="/tentang-kami" label="Kenali Perusahaan Kami" variant="text" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <span class="eyebrow">Langkah berikutnya</span>
        <h2>Mari Bahas Kebutuhan Pasokan Anda</h2>
        <p>Jadwalkan percakapan awal untuk membahas jenis produk, spesifikasi, volume, dan kebutuhan distribusi bisnis Anda.</p>
      </div>
      <ButtonLink href={meetingHref} label="Jadwalkan Pertemuan" analyticsSource="home-final" external={meetingHref.startsWith('https://wa.me/')} />
    </div>
  </section>
</BaseLayout>

<style>
  .trust-strip {
    position: relative;
    z-index: 4;
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }

  .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .trust-strip__item {
    display: grid;
    gap: 0.2rem;
    padding: 1.75rem clamp(1rem, 4vw, 3rem);
    border-right: 1px solid var(--line);
  }

  .trust-strip__item:first-child {
    border-left: 1px solid var(--line);
  }

  .trust-strip__item strong {
    color: var(--navy-950);
    font-family: 'Manrope', sans-serif;
    font-size: 1.25rem;
  }

  .trust-strip__item span {
    color: var(--slate);
    font-size: 0.84rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .category-card {
    position: relative;
    display: grid;
    min-height: 25rem;
    align-items: end;
    padding: 2rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    color: rgba(255, 255, 255, 0.74);
    background: linear-gradient(145deg, var(--ocean-600), var(--navy-900));
    box-shadow: var(--shadow-sm);
  }

  .category-card:nth-child(2) {
    background: linear-gradient(145deg, #245975, var(--navy-950));
  }

  .category-card::before {
    position: absolute;
    top: -5rem;
    right: -4rem;
    width: 21rem;
    height: 21rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    box-shadow: 0 0 0 3rem rgba(255, 255, 255, 0.03), 0 0 0 6rem rgba(255, 255, 255, 0.02);
    content: '';
    transition: transform 350ms ease;
  }

  .category-card:hover::before {
    transform: scale(1.08);
  }

  .category-card > div,
  .category-card__index {
    position: relative;
  }

  .category-card__index {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .category-card h3 {
    margin-bottom: 0.75rem;
    color: var(--white);
    font-size: clamp(1.7rem, 4vw, 2.5rem);
  }

  .category-card p {
    max-width: 28rem;
  }

  .category-card__link {
    color: var(--white);
    font-weight: 700;
  }

  .section-link {
    margin-top: 1rem;
  }

  .specification__grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .specification h2 {
    max-width: 14ch;
  }

  .specification p {
    max-width: 40rem;
    margin-bottom: 2rem;
  }

  .specification__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .specification__list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .specification__list span {
    color: #7ce0f2;
    font-size: 0.75rem;
  }

  .specification__list strong {
    color: var(--white);
  }

  .about-preview {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .about-preview__visual {
    position: relative;
    display: grid;
    min-height: 31rem;
    place-items: center;
    overflow: hidden;
    border-radius: 10rem 10rem var(--radius-md) var(--radius-md);
    color: rgba(255, 255, 255, 0.12);
    background: linear-gradient(150deg, var(--ocean-500), var(--navy-950));
  }

  .about-preview__visual span {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(5rem, 16vw, 10rem);
    font-weight: 800;
  }

  .about-preview__visual div {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    box-shadow: 0 0 0 3rem rgba(255, 255, 255, 0.04);
  }

  @media (max-width: 780px) {
    .trust-strip__grid,
    .category-grid,
    .specification__grid,
    .about-preview {
      grid-template-columns: 1fr;
    }

    .trust-strip__item,
    .trust-strip__item:first-child {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      border-left: 0;
    }

    .category-card {
      min-height: 21rem;
    }

    .about-preview__visual {
      min-height: 24rem;
    }
  }
</style>
