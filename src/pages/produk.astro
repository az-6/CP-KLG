---
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductCatalog } from '../lib/sanity/product-repository';

const { categories, products } = await getProductCatalog();
---

<BaseLayout
  title="Produk Ikan untuk Distributor dan Pedagang Besar"
  description="Jelajahi kategori tuna, ikan dasar, dan contoh kategori produk PT Katalis Lintas Global. Spesifikasi dibahas sesuai kebutuhan buyer."
  canonicalPath="/produk"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Katalog produk</span>
      <h1>Produk untuk Kebutuhan Pasokan B2B</h1>
      <p>Temukan kategori produk utama kami. Informasi harga dan stok dibahas setelah kebutuhan, volume, serta spesifikasi buyer dipahami.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Pilihan tersedia"
        title="Katalog Produk"
        description="Jelajahi kategori aktif dan buka detail produk untuk membahas spesifikasi sesuai kebutuhan bisnis Anda."
      />

      <div class="filters" role="group" aria-label="Filter kategori produk">
        <button type="button" data-filter="all" aria-pressed="true">Semua</button>
        {categories.map((category) => (
          <button type="button" data-filter={category.slug} aria-pressed="false">{category.name}</button>
        ))}
      </div>

      <div class="products-grid" aria-live="polite">
        {products.map((product) => (
          <div data-product-filter-item data-product-category={product.categorySlug}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <p class="catalog-note">Harga dan ketersediaan aktual tidak ditampilkan secara real-time. Silakan jadwalkan pertemuan untuk mendiskusikan kebutuhan pasokan Anda.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-product-filter-item]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.filter;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach((card) => {
        card.hidden = selected !== 'all' && card.dataset.productCategory !== selected;
      });
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .filters button {
    min-height: 2.85rem;
    padding-inline: 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--slate);
    background: var(--white);
    cursor: pointer;
  }

  .filters button[aria-pressed='true'] {
    color: var(--white);
    border-color: var(--navy-950);
    background: var(--navy-950);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .catalog-note {
    margin-top: 2rem;
    padding: 1.2rem;
    border-left: 3px solid var(--ocean-500);
    color: var(--slate);
    background: var(--ice-50);
  }

  @media (max-width: 720px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
