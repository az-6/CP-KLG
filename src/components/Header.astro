---
import { company } from '../data/company';
import { navigation } from '../data/navigation';
import { getMeetingHref } from '../lib/whatsapp';
import logoFull from '../assets/logo-klg-transparent.png';
import logoMark from '../assets/logo-mark-transparent.png';

const currentPath = Astro.url.pathname;
const meetingHref = getMeetingHref(company.contact.whatsappNumber);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${company.name} — Beranda`}>
      <picture class="brand__picture">
        <source media="(max-width: 420px)" srcset={logoMark.src} />
        <img class="brand__logo" src={logoFull.src} width={logoFull.width} height={logoFull.height} alt="" />
      </picture>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Navigasi utama">
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="header-cta"
        href={meetingHref}
        target={meetingHref.startsWith('https://wa.me/') ? '_blank' : undefined}
        rel={meetingHref.startsWith('https://wa.me/') ? 'noopener noreferrer' : undefined}
        data-whatsapp-source="header"
      >
        Jadwalkan Pertemuan
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');
  const mobileQuery = window.matchMedia('(max-width: 980px)');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('primary-nav--open');
    document.body.classList.remove('menu-open');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('primary-nav--open', !isOpen);
    document.body.classList.toggle('menu-open', !isOpen);
  });

  mobileQuery.addEventListener('change', (event) => {
    if (!event.matches) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    color: var(--navy-950);
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(215, 226, 232, 0.8);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand__picture {
    display: block;
    width: clamp(10.5rem, 16vw, 13.5rem);
  }

  .brand__logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .primary-nav,
  .primary-nav ul {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: 1.3rem;
  }

  .primary-nav ul {
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav ul a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.72rem;
    color: var(--slate);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .primary-nav ul a:hover,
  .primary-nav ul a[aria-current='page'] {
    color: var(--ocean-600);
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    padding-inline: 1.1rem;
    border-radius: 999px;
    color: var(--white);
    background: var(--navy-950);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .menu-toggle {
    display: none;
    min-width: 3rem;
    min-height: 3rem;
    border: 0;
    background: transparent;
  }

  @media (max-width: 980px) {
    .menu-toggle {
      display: grid;
      place-items: center;
      color: var(--navy-950);
    }

    .menu-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .menu-toggle__icon {
      display: grid;
      gap: 0.38rem;
    }

    .menu-toggle__icon i {
      width: 1.5rem;
      height: 2px;
      background: currentColor;
      transition: transform 180ms ease;
    }

    .menu-toggle[aria-expanded='true'] i:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] i:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .primary-nav {
      position: fixed;
      inset: 5rem 0 auto;
      display: none;
      min-height: calc(100vh - 5rem);
      align-items: stretch;
      flex-direction: column;
      padding: 2rem 1rem;
      background: var(--white);
    }

    .primary-nav--open {
      display: flex;
    }

    .primary-nav ul {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-nav ul a {
      min-height: 3.5rem;
      border-bottom: 1px solid var(--line);
      font-size: 1.05rem;
    }

    .header-cta {
      justify-content: center;
      margin-top: 1rem;
    }
  }

  @media (max-width: 420px) {
    .brand__picture {
      width: 3.25rem;
    }
  }
</style>
