---
import { company } from '../data/company';
import { navigation } from '../data/navigation';
import { getMeetingHref } from '../lib/whatsapp';

const currentPath = Astro.url.pathname;
const meetingHref = getMeetingHref(company.contact.whatsappNumber);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${company.name} — Beranda`}>
      <span class="brand__mark" aria-hidden="true">KLG</span>
      <span class="brand__name">
        <strong>Katalis Lintas</strong>
        <small>Global</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Navigasi utama">
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="header-cta"
        href={meetingHref}
        target={meetingHref.startsWith('https://wa.me/') ? '_blank' : undefined}
        rel={meetingHref.startsWith('https://wa.me/') ? 'noopener noreferrer' : undefined}
        data-whatsapp-source="header"
      >
        Jadwalkan Pertemuan
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('primary-nav--open', !isOpen);
    document.body.classList.toggle('menu-open', !isOpen);
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    color: var(--navy-950);
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(215, 226, 232, 0.8);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .brand__mark {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    border-radius: 50% 50% 50% 0;
    color: var(--white);
    background: linear-gradient(145deg, var(--ocean-500), var(--navy-800));
    font-family: 'Manrope', sans-serif;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    transform: rotate(-10deg);
  }

  .brand__mark::first-letter {
    transform: rotate(10deg);
  }

  .brand__name {
    display: grid;
    line-height: 1.05;
  }

  .brand__name strong {
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
  }

  .brand__name small {
    margin-top: 0.25rem;
    color: var(--ocean-600);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .primary-nav,
  .primary-nav ul {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: 1.3rem;
  }

  .primary-nav ul {
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav ul a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.72rem;
    color: var(--slate);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .primary-nav ul a:hover,
  .primary-nav ul a[aria-current='page'] {
    color: var(--ocean-600);
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    padding-inline: 1.1rem;
    border-radius: 999px;
    color: var(--white);
    background: var(--navy-950);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .menu-toggle {
    display: none;
    min-width: 3rem;
    min-height: 3rem;
    border: 0;
    background: transparent;
  }

  @media (max-width: 980px) {
    .menu-toggle {
      display: grid;
      place-items: center;
      color: var(--navy-950);
    }

    .menu-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .menu-toggle__icon {
      display: grid;
      gap: 0.38rem;
    }

    .menu-toggle__icon i {
      width: 1.5rem;
      height: 2px;
      background: currentColor;
      transition: transform 180ms ease;
    }

    .menu-toggle[aria-expanded='true'] i:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] i:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .primary-nav {
      position: fixed;
      inset: 5rem 0 auto;
      display: none;
      min-height: calc(100vh - 5rem);
      align-items: stretch;
      flex-direction: column;
      padding: 2rem 1rem;
      background: var(--white);
    }

    .primary-nav--open {
      display: flex;
    }

    .primary-nav ul {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-nav ul a {
      min-height: 3.5rem;
      border-bottom: 1px solid var(--line);
      font-size: 1.05rem;
    }

    .header-cta {
      justify-content: center;
      margin-top: 1rem;
    }
  }
</style>
