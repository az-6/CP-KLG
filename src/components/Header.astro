---
import { company } from '../data/company';
import { navigation } from '../data/navigation';
import { getMeetingHref } from '../lib/whatsapp';
import logoFull from '../assets/logo-klg-transparent.png';
const currentPath = Astro.url.pathname;
const meetingHref = getMeetingHref(company.contact.whatsappNumber);
---
<div class="utility-bar">
  <div class="container"><span>PT Katalis Lintas Global</span><span>Pasokan ikan untuk bisnis <i></i> {company.contact.address}</span></div>
</div>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${company.name} — Beranda`}>
      <img src={logoFull.src} width={logoFull.width} height={logoFull.height} alt="" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="visually-hidden">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="Navigasi utama">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href} aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="header-cta" href={meetingHref} target={meetingHref.startsWith('https://wa.me/') ? '_blank' : undefined} rel={meetingHref.startsWith('https://wa.me/') ? 'noopener noreferrer' : undefined} data-whatsapp-source="header">
        Jadwalkan Pertemuan <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');
  const mobileQuery = window.matchMedia('(max-width: 1100px)');
  const backgrounds = document.querySelectorAll<HTMLElement>('main, .footer, .utility-bar');
  const closeMenu = (restoreFocus = false) => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('primary-nav--open');
    document.body.classList.remove('menu-open');
    backgrounds.forEach((element) => { element.inert = false; });
    if (restoreFocus) toggle?.focus();
  };
  toggle?.addEventListener('click', () => {
    if (toggle.getAttribute('aria-expanded') === 'true') { closeMenu(true); return; }
    toggle.setAttribute('aria-expanded', 'true');
    nav?.classList.add('primary-nav--open');
    document.body.classList.add('menu-open');
    backgrounds.forEach((element) => { element.inert = true; });
  });
  mobileQuery.addEventListener('change', (event) => { if (!event.matches) closeMenu(); });
  document.addEventListener('keydown', (event) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') { event.preventDefault(); closeMenu(true); }
    if (event.key === 'Tab' && nav) {
      const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href]'));
      const last = links.at(-1);
      if (event.shiftKey && document.activeElement === toggle) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); toggle.focus(); }
    }
  });
</script>
<style>
  .utility-bar { color: #5a7274; background: var(--ice-50); border-bottom: 1px solid var(--line); font-size: 0.65rem; letter-spacing: 0.045em; }
  .utility-bar .container { display: flex; min-height: 2.1rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .utility-bar .container > span:last-child { display: flex; align-items: center; gap: 1rem; }
  .utility-bar i { height: 0.7rem; width: 1px; background: #aabfba; }
  .site-header { position: sticky; z-index: 50; top: 0; border-bottom: 1px solid var(--line); background: var(--white); }
  .site-header__inner { display: flex; height: 5.25rem; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; flex-shrink: 0; width: 13.5rem; }
  .brand img { width: 100%; height: auto; }
  .primary-nav, .primary-nav ul { display: flex; align-items: center; }
  .primary-nav { gap: 1.8rem; }
  .primary-nav ul { gap: 1.2rem; list-style: none; margin: 0; padding: 0; }
  .primary-nav ul a { position: relative; display: inline-flex; min-height: 5.25rem; align-items: center; color: var(--slate); font-size: 0.78rem; font-weight: 500; white-space: nowrap; }
  .primary-nav ul a::after { position: absolute; bottom: 0; inset-inline: 0; height: 2px; background: var(--ocean-600); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; content: ''; }
  .primary-nav ul a:hover, .primary-nav ul a[aria-current='page'] { color: var(--ocean-600); }
  .primary-nav ul a:hover::after, .primary-nav ul a[aria-current='page']::after { transform: scaleX(1); }
  .header-cta { display: inline-flex; min-height: 2.8rem; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 1rem; border: 1px solid var(--navy-950); border-radius: var(--radius-sm); color: var(--navy-950); font-size: 0.76rem; font-weight: 600; transition: background-color 180ms ease, color 180ms ease; }
  .header-cta:hover { color: var(--white); background: var(--navy-950); }
  .header-cta span { font-size: 1.2rem; line-height: 1; }
  .menu-toggle { display: none; min-height: 3rem; min-width: 3rem; padding: 0.5rem; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--navy-950); background: transparent; }
  .menu-toggle__icon { display: grid; gap: 0.4rem; }
  .menu-toggle__icon i { display: block; width: 1.35rem; height: 1px; background: currentColor; transition: transform 180ms ease; }
  .menu-toggle[aria-expanded='true'] i:first-child { transform: translateY(3.7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] i:last-child { transform: translateY(-3.7px) rotate(-45deg); }
  @media (max-width: 1100px) {
    .menu-toggle { display: grid; place-items: center; }
    .primary-nav { position: fixed; inset: 5.25rem 0 0; display: none; height: calc(100dvh - 5.25rem); overflow-y: auto; align-items: stretch; flex-direction: column; gap: 2rem; padding: 1.5rem 2rem 3rem; background: var(--white); }
    .primary-nav--open { display: flex; }
    .primary-nav ul { align-items: stretch; flex-direction: column; gap: 0; }
    .primary-nav ul a { display: flex; min-height: 3.7rem; border-bottom: 1px solid var(--line); font-family: var(--font-heading); font-size: 1.1rem; }
    .header-cta { min-height: 3.2rem; font-size: 0.9rem; }
    .utility-bar { display: none; }
  }
  @media (max-width: 600px) { .brand { width: 12rem; } .site-header__inner { gap: 1rem; } .primary-nav { padding-inline: 1.25rem; } }
</style>
