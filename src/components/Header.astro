---
import { company } from '../data/company';
import { meetingHrefFor, navigation, routes, ui, type Alternates, type Locale } from '../i18n';
import { isWhatsAppHref } from '../lib/whatsapp';
import logoFull from '../assets/logo-klg-transparent.png';
import logoMark from '../assets/logo-mark-transparent.png';

interface Props {
  locale: Locale;
  alternates?: Alternates;
}

const { locale, alternates = {} } = Astro.props;
const t = ui[locale];
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const otherHref = alternates[otherLocale] ?? routes.home[otherLocale];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const meetingHref = meetingHrefFor(locale);
const homeHref = routes.home[locale];

const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/' || target === '/en') return currentPath === target;
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={homeHref} aria-label={`${company.name}, ${t.homeLabel}`}>
      <picture class="brand__picture">
        <source media="(max-width: 420px)" srcset={logoMark.src} />
        <img class="brand__logo" src={logoFull.src} width={logoFull.width} height={logoFull.height} alt="" />
      </picture>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="menu-toggle__label">{t.menu}</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label={t.primaryNav}>
      <ul>
        {navigation[locale].map((item) => (
          <li>
            <a href={item.href} hreflang={item.hreflang} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="lang-switch" href={otherHref} hreflang={otherLocale} lang={otherLocale}>
        <span class="visually-hidden">{t.languageLabel}: </span>{t.otherLanguage}
      </a>
      <a
        class="header-cta"
        href={meetingHref}
        target={isWhatsAppHref(meetingHref) ? '_blank' : undefined}
        rel={isWhatsAppHref(meetingHref) ? 'noopener noreferrer' : undefined}
        data-whatsapp-source="header"
      >
        {t.meeting}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');
  const mobileQuery = window.matchMedia('(max-width: 1180px)');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('primary-nav--open');
    document.body.classList.remove('menu-open');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('primary-nav--open', !isOpen);
    document.body.classList.toggle('menu-open', !isOpen);
  });

  mobileQuery.addEventListener('change', (event) => {
    if (!event.matches) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: var(--rule) solid var(--ink);
    color: var(--ink);
    background: var(--paint);
  }

  .site-header__inner {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
  }

  .brand__picture {
    display: block;
    width: clamp(11rem, 15vw, 14rem);
  }

  .brand__logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .primary-nav,
  .primary-nav ul {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: 1rem;
  }

  .primary-nav ul {
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav ul a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.62rem;
    font-size: var(--text-nav);
    font-weight: 620;
    text-decoration: none;
  }

  .primary-nav ul a:hover {
    color: var(--hull-deep);
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
  }

  .primary-nav ul a[aria-current='page'] {
    color: var(--hull-deep);
    text-decoration: underline;
    text-decoration-color: var(--hull);
    text-decoration-thickness: var(--rule);
  }

  .lang-switch {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.6rem;
    font-size: var(--text-nav);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang-switch:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    padding-inline: 1.1rem;
    color: var(--on-hull);
    background: var(--ink);
    font-size: var(--text-label);
    font-stretch: var(--stretch-plate);
    font-weight: 780;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 220ms var(--ease-out);
  }

  .header-cta:hover {
    background: var(--hull);
  }

  .menu-toggle {
    display: none;
    min-width: 3rem;
    min-height: 3rem;
    border: 0;
    background: transparent;
  }

  @media (max-width: 1180px) {
    .menu-toggle {
      display: grid;
      color: var(--ink);
      cursor: pointer;
      place-items: center;
    }

    .menu-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .menu-toggle__icon {
      display: grid;
      gap: 0.4rem;
    }

    .menu-toggle__icon i {
      width: 1.6rem;
      height: 3px;
      background: currentColor;
      transition: transform 220ms var(--ease-out);
    }

    .menu-toggle[aria-expanded='true'] i:first-child {
      transform: translateY(5px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] i:last-child {
      transform: translateY(-5px) rotate(-45deg);
    }

    .primary-nav {
      position: fixed;
      inset: calc(5rem + var(--rule)) 0 auto;
      display: none;
      min-height: calc(100dvh - 5rem);
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding: 1rem var(--gutter) 2rem;
      overflow-y: auto;
      color: var(--on-hull);
      background: var(--hull);
    }

    .primary-nav--open {
      display: flex;
    }

    .primary-nav ul {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-nav ul a {
      width: 100%;
      min-height: 3.6rem;
      padding-inline: 0;
      border-bottom: 1px solid var(--seam);
      font-size: var(--text-subhead);
      font-stretch: var(--stretch-hull);
      font-weight: 800;
      text-transform: uppercase;
    }

    .primary-nav ul a:hover,
    .primary-nav ul a[aria-current='page'] {
      color: var(--on-hull);
      text-decoration-color: var(--on-hull);
    }

    .lang-switch {
      min-height: 3.5rem;
      padding-inline: 0;
      color: var(--on-hull);
      font-size: var(--text-body);
    }

    .header-cta {
      min-height: 3.5rem;
      justify-content: center;
      margin-top: 1rem;
      color: var(--ink);
      background: var(--on-hull);
      font-size: var(--text-nav);
    }

    .header-cta:hover {
      color: var(--on-hull);
      background: var(--ink);
    }
  }

  @media (max-width: 420px) {
    .brand__picture {
      width: 3.25rem;
    }
  }
</style>
