---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
.section-heading { max-width: 44rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .section-heading h2 { margin-bottom: 1.1rem; }
  .section-heading p { max-width: 37rem; color: var(--slate); font-size: 1rem; line-height: 1.8; }
  .section-heading--center { margin-inline: auto; text-align: center; }
  .section-heading--center p { margin-inline: auto; }
  .section-heading--center .eyebrow { justify-content: center; }
</style>
