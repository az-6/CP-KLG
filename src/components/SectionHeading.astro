---
interface Props {
  title: string;
  description?: string;
  id?: string;
  align?: 'left' | 'split';
}

const { title, description, id, align = 'left' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <h2 id={id}>{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
  .section-heading {
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .section-heading h2 {
    max-width: 24ch;
  }

  .section-heading p {
    max-width: 46rem;
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }

  :global(.hull) .section-heading p {
    color: var(--on-hull-soft);
  }

  .section-heading--split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 1rem clamp(2rem, 5vw, 5rem);
  }

  .section-heading--split h2 {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .section-heading--split {
      grid-template-columns: 1fr;
    }
  }
</style>
