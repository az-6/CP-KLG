---
import type { Locale } from '../i18n';
import type { CredentialDocument } from '../types/sanity';
import SanityImage from './SanityImage.astro';

interface Props { credentials: CredentialDocument[]; locale?: Locale }
const { credentials, locale = 'id' } = Astro.props;
const label = locale === 'en'
  ? { open: 'Enlarge', close: 'Close preview' }
  : { open: 'Perbesar', close: 'Tutup pratinjau' };
---

<div class="credential-gallery">
  {credentials.map((credential) => {
    const dialogId = `credential-${credential._id.replace(/[^A-Za-z0-9_-]/g, '-')}`;
    const titleId = `${dialogId}-title`;
    return (
      <article class="credential-card">
        <SanityImage image={credential.previewImage} width={560} height={720} widths={[320, 560]} sizes="(max-width: 620px) 100vw, 33vw" />
        <div>
          <h3>{credential.name}</h3>
          <p>{credential.description}</p>
          <button type="button" data-dialog-open={dialogId}>{label.open} {credential.name}</button>
        </div>
        <dialog id={dialogId} aria-labelledby={titleId}>
          <div class="credential-dialog__header">
            <h2 id={titleId}>{credential.name}</h2>
            <button type="button" data-dialog-close>{label.close}</button>
          </div>
          <SanityImage image={credential.previewImage} width={1000} height={1400} widths={[560, 1000]} sizes="min(90vw, 800px)" />
          <p>{credential.description}</p>
        </dialog>
      </article>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((opener) => {
    const dialog = document.getElementById(opener.dataset.dialogOpen ?? '') as HTMLDialogElement | null;
    if (!dialog) return;
    const closer = dialog.querySelector<HTMLButtonElement>('[data-dialog-close]');
    opener.addEventListener('click', () => dialog.showModal());
    closer?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener.focus());
  });
</script>

<style>
  .credential-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .credential-card { border: var(--rule) solid var(--ink); background: var(--paint); }
  .credential-card > :global(img) { width: 100%; aspect-ratio: 4 / 3; border-bottom: var(--rule) solid var(--ink); object-fit: cover; }
  .credential-card > div { padding: 1.25rem; }
  .credential-card h3 { font-stretch: var(--stretch-plate); }
  .credential-card p { color: var(--ink-soft); }
  .credential-card button,
  .credential-dialog__header button { min-height: 2.9rem; padding: 0.7rem 1.1rem; border: var(--rule) solid var(--hull); color: var(--on-hull); background: var(--hull); cursor: pointer; font: inherit; font-size: 0.85rem; font-stretch: var(--stretch-plate); font-weight: 760; letter-spacing: 0.05em; text-transform: uppercase; transition: background-color 220ms var(--ease-out), border-color 220ms var(--ease-out); }
  .credential-card button:hover,
  .credential-dialog__header button:hover { border-color: var(--ink); background: var(--ink); }
  dialog { width: min(90vw, 52rem); max-height: 90vh; padding: 1.25rem; border: var(--rule-heavy) solid var(--ink); color: var(--ink); background: var(--paint); }
  dialog::backdrop { background: rgba(8, 73, 122, 0.85); }
  dialog :global(img) { display: block; width: 100%; height: auto; max-height: 65vh; object-fit: contain; }
  .credential-dialog__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .credential-dialog__header h2 { margin: 0; font-size: clamp(1.25rem, 2.5vw, 1.8rem); }
</style>
