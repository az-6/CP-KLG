---
interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        {index < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 0 0 1.5rem; padding: 0; list-style: none; }
  .breadcrumbs li { display: flex; gap: 0.55rem; color: var(--slate); font-size: 0.9rem; }
  .breadcrumbs a { color: var(--ocean-600); font-weight: 700; }
</style>
