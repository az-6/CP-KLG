---
interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        {index < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 0 0 2rem; padding: 0; list-style: none; }
  .breadcrumbs li { display: flex; gap: 0.55rem; color: var(--ink-soft); font-size: 0.85rem; font-stretch: var(--stretch-plate); font-weight: 650; letter-spacing: 0.05em; text-transform: uppercase; }
  .breadcrumbs a { color: var(--hull-deep); font-weight: 760; }
  .breadcrumbs a:hover { color: var(--ink); }
</style>
