---
import { PortableText } from 'astro-portabletext';
import type { PortableTextBlock } from '@portabletext/types';
import type { SanityImage } from '../types/sanity';
import PortableLink from './PortableLink.astro';
import PortableSanityImage from './PortableSanityImage.astro';

interface Props {
  value: Array<PortableTextBlock | SanityImage>;
}

const { value } = Astro.props;
const components = {
  type: { imageWithAlt: PortableSanityImage, image: PortableSanityImage },
  mark: { link: PortableLink },
};
---

<div class="portable-content">
  <PortableText {value} {components} />
</div>

<style>
  .portable-content { color: var(--ink); font-size: var(--text-reading); line-height: 1.7; }
  .portable-content :global(p) { max-width: 68ch; }
  .portable-content :global(h2), .portable-content :global(h3) { margin-top: 2.75rem; color: var(--ink); }
  .portable-content :global(h2) { font-size: var(--text-subhead); }
  .portable-content :global(a) { color: var(--hull-deep); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.22em; }
  .portable-content :global(a:hover) { color: var(--ink); }
  .portable-content :global(figure) { margin: 2.5rem 0; }
  .portable-content :global(figure img) { width: 100%; height: auto; border: var(--rule) solid var(--ink); }
  .portable-content :global(figcaption) { margin-top: 0.6rem; color: var(--ink-soft); font-size: var(--text-small); }
</style>
