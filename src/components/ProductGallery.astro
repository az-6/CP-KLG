---
import type { SanityImage as SanityImageData } from '../types/sanity';
import { getLocalProductPhotos } from '../data/product-photos';
import { isSanityFixtureMode } from '../lib/sanity/config';
import SanityImage from './SanityImage.astro';

interface Props { images: SanityImageData[]; productName: string; productSlug?: string; locale?: 'id' | 'en' }
const { images, productName, productSlug = '', locale = 'id' } = Astro.props;
const localPhotos = getLocalProductPhotos({ slug: productSlug, name: productName }, locale);
const useLocalPhotos = localPhotos.length > 0 && (images.length === 0 || isSanityFixtureMode(import.meta.env, process.env));
---

<div class="product-gallery" aria-label={locale === 'en' ? `${productName} product photos` : `Foto produk ${productName}`}>
  {useLocalPhotos && localPhotos.map((photo, index) => (
    <figure class:list={{ 'product-gallery__primary': index === 0 }}>
      <img
        src={photo.src}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    </figure>
  ))}
  {!useLocalPhotos && images.map((image, index) => (
    <figure class:list={{ 'product-gallery__primary': index === 0 }}>
      <SanityImage image={image} width={1200} height={800} widths={[480, 768, 1200]} sizes={index === 0 ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 900px) 50vw, 30vw'} loading={index === 0 ? 'eager' : 'lazy'} />
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .product-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .product-gallery figure { margin: 0; border: var(--rule) solid var(--ink); background: var(--paint-shade); }
  .product-gallery__primary { grid-column: 1 / -1; }
  .product-gallery img,
  .product-gallery :global(img) { display: block; width: 100%; height: 100%; max-height: 38rem; object-fit: cover; }
  .product-gallery figcaption { padding: 0.7rem 0.85rem; border-top: var(--rule) solid var(--ink); color: var(--ink-soft); font-size: 0.88rem; }
</style>
