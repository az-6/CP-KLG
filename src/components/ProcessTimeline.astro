---
import type { ProcessStep } from '../types/content';

interface Props {
  steps: ProcessStep[];
  compact?: boolean;
}

const { steps, compact = false } = Astro.props;
---

<ol class:list={['process', { 'process--compact': compact }]}>
  {steps.map((step) => (
    <li class="process__item">
      <span class="process__number">{step.number}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
.process { display: grid; margin: 0; padding: 0; list-style: none; }
  .process__item { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 0 0 2rem; }
  .process__item:not(:last-child)::after { position: absolute; top: 2.75rem; bottom: 0.5rem; left: 1.25rem; width: 1px; background: var(--line); content: ''; }
  .process__number { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 1px solid #a5beba; border-radius: 2px; color: var(--ocean-600); background: var(--white); font-size: 0.72rem; font-weight: 600; }
  .process h3 { margin-bottom: 0.6rem; font-size: 1.05rem; }
  .process p { margin: 0; color: var(--slate); font-size: 0.9rem; line-height: 1.75; }
  @media (min-width: 900px) {
    .process--compact { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; }
    .process--compact .process__item { grid-template-columns: 1fr; padding: 0; gap: 1.5rem; align-content: start; }
    .process--compact .process__item:not(:last-child)::after { top: 1.25rem; right: -0.75rem; bottom: auto; left: 3.25rem; width: auto; height: 1px; }
  }
</style>
