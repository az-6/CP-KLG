---
import type { ProcessStep } from '../types/content';

interface Props {
  steps: ProcessStep[];
  /** Deretan pelat horizontal di bidang lambung (beranda); tanpanya, daftar vertikal. */
  compact?: boolean;
}

const { steps, compact = false } = Astro.props;
---

<ol class:list={['process', { 'process--plates': compact }]}>
  {steps.map((step, index) => (
    <li class="process__item">
      <span class="process__number draft-num" aria-hidden="true">{index + 1}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process {
    margin: 0;
    padding: 0;
    border-top: var(--rule-heavy) solid var(--ink);
    list-style: none;
  }

  .process__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.6rem;
    border-bottom: var(--rule) solid var(--ink);
  }

  .process__number {
    color: var(--hull);
    font-size: 3.6rem;
  }

  .process h3 {
    margin-bottom: 0.35rem;
  }

  .process p {
    margin: 0;
    color: var(--ink-soft);
  }

  /* Pelat yang dilas berdampingan di bidang lambung. */
  .process--plates {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: var(--rule) solid var(--on-hull);
  }

  .process--plates .process__item {
    grid-template-columns: 1fr;
    align-content: start;
    gap: 1.25rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-bottom: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.35);
  }

  .process--plates .process__item:last-child {
    border-right: 0;
  }

  .process--plates .process__number {
    color: var(--on-hull);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
  }

  .process--plates h3 {
    color: var(--on-hull);
  }

  .process--plates p {
    color: var(--on-hull-soft);
  }

  @media (max-width: 960px) {
    .process--plates {
      grid-template-columns: 1fr;
    }

    .process--plates .process__item {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    }

    .process--plates .process__item:last-child {
      border-bottom: 0;
    }

    .process--plates .process__number {
      font-size: 3.6rem;
    }
  }
</style>
