---
import type { ProcessStep } from '../types/content';

interface Props {
  steps: ProcessStep[];
  compact?: boolean;
}

const { steps, compact = false } = Astro.props;
---

<ol class:list={['process', { 'process--compact': compact }]}>
  {steps.map((step) => (
    <li class="process__item">
      <span class="process__number">{step.number}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__item {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.25rem;
    padding: 0 0 2.5rem;
  }

  .process__item:not(:last-child)::after {
    position: absolute;
    top: 3.25rem;
    bottom: 0.5rem;
    left: 1.5rem;
    width: 1px;
    background: var(--line);
    content: '';
  }

  .process__number {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--ocean-500);
    border-radius: 50%;
    color: var(--ocean-600);
    background: var(--white);
    font-family: 'Manrope', sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .process h3 {
    margin-bottom: 0.45rem;
  }

  .process p {
    margin: 0;
    color: var(--slate);
  }

  @media (min-width: 900px) {
    .process--compact {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }

    .process--compact .process__item {
      grid-template-columns: 1fr;
      padding: 0;
    }

    .process--compact .process__item:not(:last-child)::after {
      top: 1.5rem;
      right: -1rem;
      bottom: auto;
      left: 3.5rem;
      width: auto;
      height: 1px;
    }
  }
</style>
