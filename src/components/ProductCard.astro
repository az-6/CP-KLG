---
import type { ProductDocument } from '../types/sanity';
import ButtonLink from './ButtonLink.astro';
import SanityImage from './SanityImage.astro';

interface Props {
  product: ProductDocument;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const primaryImage = product.images[0];
---

<article class="product-card" data-product-category={product.categorySlug} data-product-slug={product.slug}>
  <div class="product-card__media">
    {primaryImage ? (
      <SanityImage image={primaryImage} width={720} height={480} widths={[480, 720]} sizes="(max-width: 720px) 100vw, 50vw" />
    ) : (
      <div class="product-card__fallback" aria-hidden="true">{product.name.slice(0, 1)}</div>
    )}
    <span class="product-card__category">{product.categoryName}</span>
  </div>
  <div class="product-card__body">
    <Heading>{product.name}</Heading>
    {product.scientificName && <p class="product-card__scientific">{product.scientificName}</p>}
    <p>{product.excerpt}</p>
    <ButtonLink href={`/produk/${product.slug}`} label={`Lihat detail ${product.name}`} variant="text" />
  </div>
</article>

<style>
.product-card { display: grid; grid-template-rows: auto 1fr; height: 100%; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--white); transition: border-color 200ms ease; }
  .product-card:hover { border-color: #739b94; }
  .product-card__media { position: relative; aspect-ratio: 1.6; overflow: hidden; background: #e6eeea; }
  .product-card__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease; }
  .product-card:hover .product-card__media :global(img) { transform: scale(1.035); }
  .product-card__fallback { display: grid; height: 100%; place-items: center; color: #779d96; font-family: var(--font-heading); font-size: 7rem; font-weight: 400; }
  .product-card__category { position: absolute; top: 1.25rem; left: 1.25rem; padding: 0.35rem 0.7rem; border-radius: 2px; color: var(--navy-950); background: #f6faf5; font-size: 0.67rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .product-card__body { display: flex; flex-direction: column; align-items: flex-start; padding: 1.75rem; }
  .product-card__body h2, .product-card__body h3 { margin-bottom: 0.65rem; font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 500; }
  .product-card__body > p { color: var(--slate); font-size: 0.95rem; }
  .product-card__body :global(.button-link) { width: 100%; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--line); }
  .product-card__scientific { margin: -0.25rem 0 0.8rem; font-style: italic; }
  @media (max-width: 620px) { .product-card__body { padding: 1.25rem; } }
</style>
