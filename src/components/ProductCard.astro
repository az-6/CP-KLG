---
import type { ProductDocument } from '../types/sanity';
import ButtonLink from './ButtonLink.astro';
import SanityImage from './SanityImage.astro';

interface Props {
  product: ProductDocument;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const primaryImage = product.images[0];
---

<article class="product-card" data-product-category={product.categorySlug} data-product-slug={product.slug}>
  <div class="product-card__media">
    {primaryImage ? (
      <SanityImage image={primaryImage} width={720} height={480} widths={[480, 720]} sizes="(max-width: 720px) 100vw, 50vw" />
    ) : (
      <div class="product-card__fallback" aria-hidden="true">{product.name.slice(0, 1)}</div>
    )}
    <span class="product-card__category">{product.categoryName}</span>
  </div>
  <div class="product-card__body">
    <Heading>{product.name}</Heading>
    {product.scientificName && <p class="product-card__scientific">{product.scientificName}</p>}
    <p>{product.excerpt}</p>
    <ButtonLink href={`/produk/${product.slug}`} label={`Lihat detail ${product.name}`} variant="text" />
  </div>
</article>

<style>
  .product-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .product-card__media {
    position: relative;
    min-height: 18rem;
    overflow: hidden;
    background: linear-gradient(150deg, var(--ocean-600), var(--navy-900));
  }
  .product-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__fallback {
    display: grid;
    min-height: 18rem;
    place-items: center;
    color: rgba(255, 255, 255, 0.15);
    font-family: 'Manrope', sans-serif;
    font-size: 10rem;
    font-weight: 800;
  }
  .product-card__category {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    color: var(--white);
    background: rgba(6, 26, 47, 0.75);
    font-size: 0.72rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }
  .product-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.6rem;
  }
  .product-card__body > p { color: var(--slate); }
  .product-card__body :global(.button-link) { margin-top: auto; }
  .product-card__scientific { margin: -0.5rem 0 1rem; font-style: italic; }
</style>
