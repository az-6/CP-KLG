---
import type { ProductDocument } from '../types/sanity';
import { getLocalProductPhotos } from '../data/product-photos';
import { productPath, type Locale } from '../i18n';
import { isSanityFixtureMode } from '../lib/sanity/config';
import ButtonLink from './ButtonLink.astro';
import ProductName from './ProductName.astro';
import SanityImage from './SanityImage.astro';

interface Props {
  product: ProductDocument;
  headingLevel?: 'h2' | 'h3';
  locale?: Locale;
  /** Tampilkan ringkasan (dipotong 3 baris). Katalog Produk hanya menampilkan nama. */
  showExcerpt?: boolean;
}

const { product, headingLevel = 'h2', locale = 'id', showExcerpt = true } = Astro.props;
// Label tampil singkat; nama produk tetap terbaca pembaca layar.
const linkLabel = locale === 'en' ? 'View details' : 'Lihat detail';
const linkSuffix = locale === 'en' ? `for ${product.name}` : product.name;
const Heading = headingLevel;
const primaryImage = product.images[0];
const localPhoto = getLocalProductPhotos(product, locale)[0];
const useLocalPhoto = Boolean(localPhoto) && (!primaryImage || isSanityFixtureMode(import.meta.env, process.env));
---

<article class="product-card" data-product-category={product.categorySlug} data-product-slug={product.slug}>
  <div class="product-card__media">
    {useLocalPhoto ? (
      <img src={localPhoto.src} width={localPhoto.width} height={localPhoto.height} alt={localPhoto.alt} loading="lazy" decoding="async" />
    ) : primaryImage ? (
      <SanityImage image={primaryImage} width={720} height={900} widths={[480, 720]} sizes="(max-width: 720px) 100vw, 50vw" />
    ) : (
      <div class="product-card__fallback hull" aria-hidden="true">{product.name.slice(0, 1)}</div>
    )}
    <span class="product-card__category">{product.categoryName}</span>
  </div>
  <div class="product-card__body">
    <Heading class="product-card__name"><ProductName name={product.name} /></Heading>
    {product.scientificName && <p class="product-card__scientific">{product.scientificName}</p>}
    {showExcerpt && <p class="product-card__excerpt">{product.excerpt}</p>}
    <ButtonLink href={productPath(locale, product.slug)} label={linkLabel} srSuffix={linkSuffix} variant="text" />
  </div>
</article>

<style>
  .product-card {
    display: grid;
    min-width: 0;
    height: 100%;
    grid-template-rows: auto 1fr;
    border: var(--rule) solid var(--ink);
    background: var(--paint);
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: var(--rule) solid var(--ink);
    background: var(--paint-shade);
  }

  .product-card__media img,
  .product-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .product-card:hover .product-card__media img,
  .product-card:hover .product-card__media :global(img) {
    transform: scale(1.03);
  }

  .product-card__fallback {
    display: grid;
    height: 100%;
    font-size: clamp(6rem, 14vw, 10rem);
    font-stretch: var(--stretch-hull);
    font-weight: 880;
    line-height: 1;
    place-items: center;
    text-transform: uppercase;
  }

  .product-card__category {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.45rem 0.75rem;
    color: var(--on-hull);
    background: var(--ink);
    font-size: 0.74rem;
    font-stretch: var(--stretch-plate);
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .product-card__name {
    overflow-wrap: break-word;
    margin-bottom: 0.6rem;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    font-stretch: var(--stretch-hull);
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-card__excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-soft);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .product-card__body :global(.button-link) {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .product-card__scientific {
    margin-top: -0.2rem;
    font-style: italic;
  }
</style>
