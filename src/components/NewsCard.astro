---
import type { NewsDocument } from '../types/sanity';
import ButtonLink from './ButtonLink.astro';
import SanityImage from './SanityImage.astro';

interface Props { article: NewsDocument; headingLevel?: 'h2' | 'h3' }
const { article, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const publishedLabel = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(article.publishedAt));
---

<article class="news-card">
  <SanityImage image={article.coverImage} width={720} height={480} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 33vw" />
  <div class="news-card__body">
    <time datetime={article.publishedAt}>{publishedLabel}</time>
    <Heading>{article.title}</Heading>
    <p>{article.excerpt}</p>
    <ButtonLink href={`/berita/${article.slug}`} label={`Baca ${article.title}`} variant="text" />
  </div>
</article>

<style>
.news-card { display: grid; grid-template-rows: auto 1fr; height: 100%; overflow: hidden; border-bottom: 1px solid var(--line); background: transparent; }
  .news-card > :global(img) { width: 100%; aspect-ratio: 1.5; object-fit: cover; border-radius: var(--radius-sm); }
  .news-card__body { display: flex; flex-direction: column; align-items: flex-start; padding: 1.5rem 0 1rem; }
  .news-card time { color: var(--ocean-600); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.04em; }
  .news-card h2, .news-card h3 { margin-block: 0.85rem; font-size: 1.3rem; line-height: 1.4; }
  .news-card p { color: var(--slate); font-size: 0.9rem; }
  .news-card :global(.button-link) { width: 100%; margin-top: auto; font-size: 0.78rem; }
</style>
