---
import { newsPath, type Locale } from '../i18n';
import type { NewsDocument } from '../types/sanity';
import ButtonLink from './ButtonLink.astro';
import SanityImage from './SanityImage.astro';

interface Props { article: NewsDocument; headingLevel?: 'h2' | 'h3'; locale?: Locale }
const { article, headingLevel = 'h2', locale = 'id' } = Astro.props;
const Heading = headingLevel;
const publishedLabel = new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'id-ID', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(article.publishedAt));
---

<article class="news-card">
  <SanityImage image={article.coverImage} width={720} height={480} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 33vw" />
  <div class="news-card__body">
    <time datetime={article.publishedAt}>{publishedLabel}</time>
    <Heading>{article.title}</Heading>
    <p>{article.excerpt}</p>
    <ButtonLink href={newsPath(locale, article.slug)} label={locale === 'en' ? `Read ${article.title}` : `Baca ${article.title}`} variant="text" />
  </div>
</article>

<style>
  .news-card {
    display: grid;
    height: 100%;
    grid-template-rows: auto 1fr;
    border-top: var(--rule-heavy) solid var(--ink);
  }

  .news-card > :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-top: 1rem;
    object-fit: cover;
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 1.1rem;
  }

  .news-card time {
    color: var(--hull-deep);
    font-size: 0.8rem;
    font-stretch: var(--stretch-plate);
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-card h2,
  .news-card h3 {
    margin-top: 0.5rem;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-stretch: var(--stretch-plate);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: none;
  }

  .news-card p {
    color: var(--ink-soft);
  }

  .news-card :global(.button-link) {
    margin-top: auto;
  }
</style>
