---
import type { Locale } from '../i18n';
import type { ProductDocument } from '../types/sanity';
import ProductCard from './ProductCard.astro';

interface Props {
  products: ProductDocument[];
  locale: Locale;
  id: string;
}

const { products, locale, id } = Astro.props;
const label = locale === 'en'
  ? { list: 'Product list', prev: 'Previous products', next: 'Next products' }
  : { list: 'Daftar produk', prev: 'Produk sebelumnya', next: 'Produk berikutnya' };
---

<div class="product-rail" data-product-rail>
  <ul id={id} class="product-rail__track" aria-label={label.list} tabindex="0" data-rail-track>
    {products.map((product) => (
      <li class="product-rail__item">
        <ProductCard product={product} headingLevel="h3" locale={locale} />
      </li>
    ))}
  </ul>

  <!-- Kontrol hanya muncul lewat JavaScript bila produk melebihi lebar rel; tanpa JS rel tetap bisa digeser. -->
  <div class="product-rail__controls" data-rail-controls hidden>
    <p class="product-rail__count" aria-live="polite">
      <span class="draft-num" data-rail-current>1</span>
      <span class="product-rail__of">/</span>
      <span class="draft-num">{products.length}</span>
    </p>
    <div class="product-rail__buttons">
      <button type="button" class="product-rail__button" aria-label={label.prev} aria-controls={id} data-rail-prev disabled>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
          <path d="M17 10H4.5M9.5 5l-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="square" stroke-width="2.4" />
        </svg>
      </button>
      <button type="button" class="product-rail__button" aria-label={label.next} aria-controls={id} data-rail-next>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
          <path d="M3 10h12.5M10.5 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="square" stroke-width="2.4" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    const controls = rail.querySelector<HTMLElement>('[data-rail-controls]');
    const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]');
    const current = rail.querySelector<HTMLElement>('[data-rail-current]');
    if (!track || !controls || !prev || !next || !current) return;

    const items = [...track.children] as HTMLElement[];
    const step = () => {
      if (items.length < 2) return track.clientWidth;
      return items[1].offsetLeft - items[0].offsetLeft;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      controls.hidden = max <= 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
      current.textContent = String(Math.min(items.length, Math.round(track.scrollLeft / step()) + 1));
    };

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', schedule, { passive: true });
    new ResizeObserver(schedule).observe(track);
    update();
  });
</script>

<style>
  .product-rail {
    --rail-gap: clamp(1rem, 2vw, 1.5rem);
    min-width: 0;
  }

  /*
   * position: relative menjadikan rel sebagai containing block untuk elemen
   * absolut di dalam kartu (teks khusus pembaca layar), sehingga ikut terpotong
   * oleh rel dan tidak melebarkan halaman di ponsel.
   */
  .product-rail__track {
    position: relative;
    display: grid;
    grid-auto-columns: calc((100% - var(--rail-gap)) / 2);
    grid-auto-flow: column;
    gap: var(--rail-gap);
    margin: 0;
    padding: 0 0 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    list-style: none;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--ink) var(--paint-shade);
    scrollbar-width: thin;
  }

  .product-rail__track:focus-visible {
    outline-offset: 4px;
  }

  .product-rail__item {
    display: flex;
    min-width: 0;
    scroll-snap-align: start;
  }

  .product-rail__item > :global(.product-card) {
    width: 100%;
  }

  .product-rail__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: var(--rule) solid var(--ink);
  }

  .product-rail__controls[hidden] {
    display: none;
  }

  .product-rail__count {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0;
    font-size: 1.6rem;
  }

  .product-rail__of {
    color: var(--ink-soft);
    font-size: 1.1rem;
  }

  .product-rail__buttons {
    display: flex;
  }

  /* Pelat persegi yang dilas berdampingan. */
  .product-rail__button {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    border: var(--rule) solid var(--ink);
    color: var(--ink);
    background: var(--paint);
    cursor: pointer;
    place-items: center;
    transition: background-color 220ms var(--ease-out), color 220ms var(--ease-out);
  }

  .product-rail__button + .product-rail__button {
    border-left: 0;
  }

  .product-rail__button:hover:not(:disabled) {
    color: var(--on-hull);
    background: var(--ink);
  }

  .product-rail__button:disabled {
    color: var(--ink-soft);
    background: var(--paint-shade);
    cursor: default;
    opacity: 0.55;
  }

  .product-rail__button:focus-visible {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 860px) {
    .product-rail__track {
      grid-auto-columns: 82%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-rail__track {
      scroll-behavior: auto;
    }
  }
</style>
