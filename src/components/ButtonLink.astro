---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  analyticsSource?: string;
  productSlug?: string;
  hreflang?: string;
  label: string;
}

const {
  href,
  variant = 'primary',
  external = false,
  analyticsSource,
  productSlug,
  hreflang,
  label,
} = Astro.props;
---

<a
  class:list={['button-link', `button-link--${variant}`]}
  href={href}
  hreflang={hreflang}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-whatsapp-source={analyticsSource}
  data-product-slug={productSlug}
>
  <span>{label}</span>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
    <path d="M3 10h12.5M10.5 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="square" stroke-width="2.4" />
  </svg>
</a>

<style>
  .button-link {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 0.85rem 1.4rem;
    border: var(--rule) solid transparent;
    font-size: 0.95rem;
    font-stretch: var(--stretch-plate);
    font-weight: 780;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 220ms var(--ease-out), color 220ms var(--ease-out), border-color 220ms var(--ease-out);
  }

  .button-link svg {
    flex: none;
    transition: transform 260ms var(--ease-out);
  }

  .button-link:hover svg {
    transform: translateX(4px);
  }

  .button-link--primary {
    border-color: var(--hull);
    color: var(--on-hull);
    background: var(--hull);
  }

  .button-link--primary:hover {
    border-color: var(--ink);
    background: var(--ink);
  }

  .button-link--secondary {
    border-color: var(--ink);
    color: var(--ink);
    background: transparent;
  }

  .button-link--secondary:hover {
    color: var(--on-hull);
    background: var(--ink);
  }

  .button-link--text {
    min-height: 2.75rem;
    padding-inline: 0;
    border-width: 0 0 var(--rule);
    border-color: currentColor;
    color: var(--hull-deep);
  }

  .button-link--text:hover {
    color: var(--ink);
  }

  /* Di atas bidang lambung: pelat putih dan garis putih. */
  :global(.hull) .button-link--primary {
    border-color: var(--on-hull);
    color: var(--ink);
    background: var(--on-hull);
  }

  :global(.hull) .button-link--primary:hover {
    border-color: var(--ink);
    color: var(--on-hull);
    background: var(--ink);
  }

  :global(.hull) .button-link--secondary,
  :global(.hull) .button-link--text {
    border-color: var(--on-hull);
    color: var(--on-hull);
  }

  :global(.hull) .button-link--secondary:hover {
    color: var(--hull-deep);
    background: var(--on-hull);
  }
</style>
