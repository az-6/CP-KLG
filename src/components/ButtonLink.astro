---
interface Props { href: string; variant?: 'primary' | 'secondary' | 'text'; external?: boolean; analyticsSource?: string; productSlug?: string; label: string }
const { href, variant = 'primary', external = false, analyticsSource, productSlug, label } = Astro.props;
---
<a class:list={['button-link', `button-link--${variant}`]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} data-whatsapp-source={analyticsSource} data-product-slug={productSlug}>
  <span>{label}</span>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
</a>
<style>
  .button-link { display: inline-flex; min-height: 3.2rem; align-items: center; justify-content: space-between; gap: 1.4rem; padding: 0.85rem 1.35rem; border: 1px solid transparent; border-radius: var(--radius-sm); font-size: 0.84rem; font-weight: 600; line-height: 1.45; transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease; }
  .button-link svg { flex-shrink: 0; transition: transform 180ms ease; }
  .button-link:hover svg { transform: translateX(3px); }
  .button-link--primary { color: var(--white); background: var(--ocean-600); }
  .button-link--primary:hover { background: var(--ocean-500); }
  .button-link--secondary { color: var(--navy-950); border-color: #a7b9b7; background: transparent; }
  .button-link--secondary:hover { border-color: var(--ocean-600); background: var(--ice-50); }
  .button-link--text { min-height: 2.75rem; padding: 0.65rem 0; border-radius: 0; color: var(--ocean-600); }
  .button-link--text:hover { color: var(--navy-950); }
</style>
