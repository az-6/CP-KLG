---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  analyticsSource?: string;
  productSlug?: string;
  label: string;
}

const {
  href,
  variant = 'primary',
  external = false,
  analyticsSource,
  productSlug,
  label,
} = Astro.props;
---

<a
  class:list={['button-link', `button-link--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-whatsapp-source={analyticsSource}
  data-product-slug={productSlug}
>
  <span>{label}</span>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
    <path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
  </svg>
</a>

<style>
  .button-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.78rem 1.2rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 700;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .button-link:hover {
    transform: translateY(-2px);
  }

  .button-link--primary {
    color: var(--white);
    background: var(--ocean-600);
    box-shadow: 0 10px 24px rgba(8, 126, 164, 0.24);
  }

  .button-link--primary:hover {
    background: var(--ocean-500);
  }

  .button-link--secondary {
    color: var(--navy-950);
    border-color: var(--line);
    background: var(--white);
  }

  .button-link--secondary:hover {
    border-color: var(--ocean-500);
  }

  .button-link--text {
    min-height: 2.75rem;
    padding-inline: 0;
    color: var(--ocean-600);
  }
</style>
