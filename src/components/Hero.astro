---
import { routes, ui, type Locale } from '../i18n';
import { isWhatsAppHref } from '../lib/whatsapp';
import ButtonLink from './ButtonLink.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  primaryHref: string;
}

// Hero sengaja hanya teks: pemilik berencana memakai video di sini nanti.
const { locale, title, description, primaryHref } = Astro.props;
const t = ui[locale];
const productsLabel = locale === 'en' ? 'See Our Products' : 'Lihat Produk Kami';
---

<section class="hero hull hull--seams" data-draft>
  <div class="container hero__inner">
    <h1>{title}</h1>
    <div class="hero__deck">
      <p class="port-line"><span>{t.port}</span><span>{t.since}</span></p>
      <p class="hero__lede">{description}</p>
      <div class="hero__actions">
        <ButtonLink href={primaryHref} label={t.meeting} analyticsSource="hero" external={isWhatsAppHref(primaryHref)} />
        <ButtonLink href={routes.products[locale]} label={productsLabel} variant="secondary" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: flex;
    min-height: min(50rem, calc(100svh - 5rem));
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(3.5rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  /* Nama di lambung: selebar kontainer, huruf lambung sebesar yang muat. */
  .hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.1rem, 6.6vw, 6rem);
    line-height: 0.94;
  }

  /* Garis sheer putih; di bawahnya pelabuhan asal, keterangan, dan tindakan. */
  .hero__deck {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) auto;
    align-items: start;
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: var(--rule) solid var(--on-hull);
  }

  .hero .port-line {
    flex-direction: column;
    margin: 0;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
  }

  .hero .port-line > span {
    white-space: nowrap;
  }

  .hero .port-line > span + span::before {
    content: none;
  }

  .hero__lede {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  @media (max-width: 1100px) {
    .hero__deck {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .hero__actions {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 700px) {
    .hero__inner {
      min-height: 0;
    }

    .hero__deck {
      grid-template-columns: 1fr;
    }
  }
</style>
