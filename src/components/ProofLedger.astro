---
import type { Locale } from '../i18n';
import type { ProofItem } from '../types/content';

interface Props {
  proofs: ProofItem[];
  locale: Locale;
}

const { proofs, locale } = Astro.props;
const columns = locale === 'en' ? ['What we promise', 'What backs it'] : ['Janji', 'Buktinya'];
---

<div class="proof-ledger">
  <p class="proof-ledger__columns" aria-hidden="true"><span>{columns[0]}</span><span>{columns[1]}</span></p>
  <ul class="ledger">
    {proofs.map((proof) => (
      <li>
        <div>
          <h3>{proof.title}</h3>
          <p>{proof.description}</p>
        </div>
        <p class="ledger__evidence"><strong class="proof-ledger__label">{columns[1]}:</strong> {proof.evidence}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .proof-ledger__columns {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    max-width: none;
    margin-bottom: 0.6rem;
    font-size: 0.78rem;
    font-stretch: var(--stretch-hull);
    font-weight: 780;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .proof-ledger :global(.ledger h3) {
    margin-bottom: 0.6rem;
  }

  .proof-ledger :global(.ledger__evidence) {
    align-self: end;
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
  }

  /* Di desktop judul kolom sudah menyebut "Buktinya"; label baris hanya untuk pembaca layar. */
  @media (min-width: 781px) {
    .proof-ledger__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (max-width: 780px) {
    .proof-ledger__columns {
      display: none;
    }
  }
</style>
