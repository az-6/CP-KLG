---
import type { CompanyFactDocument } from '../types/sanity';

interface Props { facts: CompanyFactDocument[]; label: string }
const { facts, label } = Astro.props;
---

<div class="company-facts" role="region" aria-label={label}>
  {facts.map((fact) => (
    <div class="company-facts__item">
      <strong>{fact.value}</strong>
      <span>{fact.label}</span>
      {fact.description && <small>{fact.description}</small>}
    </div>
  ))}
</div>

<style>
.company-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .company-facts__item { display: grid; gap: 0.35rem; padding: 1.6rem 2rem; border-right: 1px solid var(--line); }
  .company-facts__item:first-child { padding-left: 0; }
  .company-facts__item:last-child { border-right: 0; }
  .company-facts strong { color: var(--navy-950); font-family: var(--font-heading); font-weight: 500; font-size: 1.65rem; letter-spacing: -0.03em; }
  .company-facts span { color: var(--ink); font-size: 0.85rem; }
  .company-facts small { color: var(--slate); font-size: 0.8rem; }
  @media (max-width: 600px) { .company-facts { grid-template-columns: 1fr; } .company-facts__item, .company-facts__item:first-child { padding: 1.3rem 0; border-right: 0; border-bottom: 1px solid var(--line); } .company-facts__item:last-child { border-bottom: 0; } }
</style>
