---
import type { CompanyFactDocument } from '../types/sanity';

interface Props { facts: CompanyFactDocument[]; label: string }
const { facts, label } = Astro.props;
---

<div class="company-facts" role="region" aria-label={label}>
  {facts.map((fact) => (
    <div class="company-facts__item">
      <strong>{fact.value}</strong>
      <span>{fact.label}</span>
      {fact.description && <small>{fact.description}</small>}
    </div>
  ))}
</div>

<style>
  .company-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    border-top: var(--rule-heavy) solid var(--ink);
    border-bottom: var(--rule) solid var(--ink);
  }

  .company-facts__item {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 1.5rem clamp(1rem, 2.5vw, 2rem) 1.6rem 0;
  }

  .company-facts__item + .company-facts__item {
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: var(--rule) solid var(--ink);
  }

  .company-facts strong {
    color: var(--hull-deep);
    font-size: var(--text-subhead);
    font-stretch: var(--stretch-hull);
    font-weight: 860;
    line-height: 1;
    text-transform: uppercase;
  }

  .company-facts span {
    font-weight: 650;
  }

  .company-facts small {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  @media (max-width: 600px) {
    .company-facts__item + .company-facts__item {
      padding-left: 0;
      border-top: var(--rule) solid var(--ink);
      border-left: 0;
    }
  }
</style>
