---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ButtonLink from '../components/ButtonLink.astro';
import PortableContent from '../components/PortableContent.astro';
import ProductGallery from '../components/ProductGallery.astro';
import { company } from '../data/company';
import { meetingHrefFor, productAlternates, productPath, routes, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSanityImageSet } from '../lib/sanity/image';
import { buildBreadcrumbJsonLd, buildProductJsonLd } from '../lib/seo';
import { isWhatsAppHref } from '../lib/whatsapp';
import type { ProductDocument } from '../types/sanity';

interface Props {
  locale: Locale;
  product: ProductDocument;
}

const { locale, product } = Astro.props;
const isId = locale === 'id';
const site = Astro.site ?? new URL('http://localhost:4321');
const path = productPath(locale, product.slug);
const text = isId
  ? {
      home: 'Beranda', products: 'Produk', info: 'Informasi Produk', discuss: `Diskusikan produk ${product.name}`,
      category: 'Kategori', sizes: 'Ukuran / grade', forms: 'Bentuk produk', condition: 'Kondisi', packaging: 'Pengemasan', volume: 'Volume',
    }
  : {
      home: 'Home', products: 'Products', info: 'Product Information', discuss: `Discuss ${product.name}`,
      category: 'Category', sizes: 'Size / grade', forms: 'Product form', condition: 'Condition', packaging: 'Packing', volume: 'Volume',
    };
const availability: Record<ProductDocument['availabilityStatus'], string> = isId
  ? { 'Tersedia berdasarkan konfirmasi': 'Tersedia berdasarkan konfirmasi', Musiman: 'Musiman', 'Tidak ditampilkan': 'Tidak ditampilkan' }
  : { 'Tersedia berdasarkan konfirmasi': 'Available on confirmation', Musiman: 'Seasonal', 'Tidak ditampilkan': 'Not listed' };
const breadcrumbs = [
  { name: text.home, path: routes.home[locale] },
  { name: text.products, path: routes.products[locale] },
  { name: product.name, path },
];
const schemas = [buildProductJsonLd(product, company, site, path), buildBreadcrumbJsonLd(breadcrumbs, site)];
const meetingHref = meetingHrefFor(locale, product.name);
const socialImage = product.seo?.socialImage ?? product.images[0];
const socialImageUrl = socialImage ? getSanityImageSet(socialImage, [1200]).src : undefined;
const facts = [
  [text.category, product.categoryName],
  product.sizes?.length ? [text.sizes, product.sizes.join(', ')] : null,
  product.forms?.length ? [text.forms, product.forms.join(', ')] : null,
  product.condition?.length ? [text.condition, product.condition.join(', ')] : null,
  product.packaging?.length ? [text.packaging, product.packaging.join(', ')] : null,
  product.volume ? [text.volume, product.volume] : null,
].filter(Boolean) as [string, string][];
---

<BaseLayout
  title={product.seo?.title ?? product.name}
  description={product.seo?.description ?? product.excerpt}
  canonicalPath={path}
  image={socialImageUrl}
  jsonLd={schemas}
  locale={locale}
  alternates={productAlternates(product.slug)}
>
  <section class="section product-detail">
    <div class="container">
      <Breadcrumbs items={breadcrumbs.map(({ name, path }, index) => ({ name, href: index < breadcrumbs.length - 1 ? path : undefined }))} />
      <div class="product-detail__grid">
        <ProductGallery images={product.images} productName={product.name} productSlug={product.slug} locale={locale} />
        <div class="product-detail__content">
          <h1>{product.name}</h1>
          {product.scientificName && <p class="scientific-name">{product.scientificName}</p>}
          <p class="lead">{product.excerpt}</p>
          <p class="availability">{availability[product.availabilityStatus] ?? product.availabilityStatus}</p>

          <dl>
            {facts.map(([label, value]) => <><dt>{label}</dt><dd>{value}</dd></>)}
          </dl>

          <ButtonLink
            href={meetingHref}
            label={text.discuss}
            external={isWhatsAppHref(meetingHref)}
            analyticsSource="product-detail"
            productSlug={product.slug}
          />
        </div>
      </div>

      <div class="product-detail__description">
        <h2>{text.info}</h2>
        <PortableContent value={product.description} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-detail { padding-top: clamp(2rem, 5vw, 4rem); }
  .product-detail__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.8fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .product-detail__content { position: sticky; top: 7rem; }
  .product-detail h1 { margin-bottom: 0.75rem; font-size: clamp(2.4rem, 5.5vw, 4.5rem); }
  .scientific-name { margin-top: -0.25rem; color: var(--ink-soft); font-style: italic; }
  .availability { display: inline-flex; padding: 0.4rem 0.7rem; color: var(--on-hull); background: var(--hull); font-size: 0.8rem; font-stretch: var(--stretch-plate); font-weight: 760; letter-spacing: 0.06em; text-transform: uppercase; }
  .product-detail dl { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); margin-block: 1.5rem 2rem; border-top: var(--rule-heavy) solid var(--ink); }
  .product-detail dt, .product-detail dd { margin: 0; padding: 0.8rem 0; border-bottom: var(--rule) solid var(--ink); }
  .product-detail dt { font-size: 0.82rem; font-stretch: var(--stretch-hull); font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
  .product-detail dd { font-weight: 650; }
  .product-detail__description { max-width: 50rem; margin-top: clamp(3rem, 8vw, 6rem); padding-top: 2rem; border-top: var(--rule-heavy) solid var(--ink); }
  @media (max-width: 860px) {
    .product-detail__grid { grid-template-columns: 1fr; }
    .product-detail__content { position: static; }
  }
</style>
